# =============================================================
# 大龙虾投研工作台 · 环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，严禁提交。
# 优先级：进程环境变量 > 本项目 .env > data/ai_config.json
# =============================================================

# ---------- AI 服务（OpenAI 兼容接口，用户自备） ----------
# 示例：https://api.deepseek.com/v1、https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=
# 密钥只填在本地 .env 或 data/ai_config.json，不得写入源码、日志或前端
OPENAI_API_KEY=
# 示例：deepseek-chat、qwen-plus、gpt-4o-mini
OPENAI_MODEL=

# ---------- 开发调试（可选） ----------
# 设为 1 时启动服务不自动打开浏览器，便于自动化测试
OPENBB_NO_BROWSER=0
