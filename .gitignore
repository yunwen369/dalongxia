# =============================================================
# OpenBB 中文投研工作台 · .gitignore
# 依据《工作规范》v7.0 §5.5；首次提交：阶段0 项目骨架初始化
# 原则：源码与配置模板入库；虚拟环境、构建产物、密钥、运行数据一律不入库
# =============================================================

# ---------- 虚拟环境（A 层运行资产，禁止入库） ----------
.venv/
.venv-verify/
venv/
env/

# ---------- Python 缓存与测试缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 构建产物（PyInstaller onedir） ----------
build/
dist/
*.spec.bak
*.manifest
*.pkg
# 说明：OpenBB-CN.spec 是手工维护的打包配置源文件，必须入库；
#      此处仅排除 PyInstaller 自动生成的 .spec 备份/临时产物。

# ---------- 日志、临时与备份文件 ----------
logs/
*.log
*.tmp
*.bak
*.old
*_副本.*
*.dmp

# ---------- 密钥与凭据（严禁入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
data/yjb_token.json
data/ai_config.json
# 养基宝签名盐（DPAPI 密文，YJB2 魔数）：绝不入库、绝不进前端
data/yjb_secret.json

# ---------- 运行数据与缓存（运行时生成，不入库） ----------
data/portfolio.json
data/watchlist.json
# 第七轮波次 5 新增运行时数据：提醒规则/事件、筛选器全市场快照（每日 18:00 自动重建）
data/alerts.json
data/screener_snapshot.json
data/cache/
data/exports/
# RT-01 脱敏审计痕迹：属用户本机安全记录（谁在何时做过解绑/清盐），不得随源码分发
data/audit/
data/*.db
data/*.sqlite
data/*.sqlite3
frontend/data/cache/

# ---------- 编辑器 / 系统文件 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
data/yjb_state.json
data/scan_tmp_*/
# 用户偏好与自建布局（本地单机数据，不入库）
data/user_prefs.json
data/dashboards.json
data/connectors.json

# PyInstaller 构建产物（阶段 9 封装）
build_v*/
dist_v*/

# 仓库内历史备份目录（归档整合后残留，仅本地保留，不入库）
C_历史备份/
