# =============================================================
# OpenBB 中文投研工作台 · .gitignore
# 依据《工作规范》v7.0 §5.5；首次提交：阶段0 项目骨架初始化
# 原则：源码与配置模板入库；虚拟环境、构建产物、密钥、运行数据一律不入库
# =============================================================

# ---------- 虚拟环境（A 层运行资产，禁止入库） ----------
.venv/
.venv-verify/
venv/
env/

# ---------- Python 缓存与测试缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 构建产物（PyInstaller onedir） ----------
build/
dist/
# NSIS 安装包输出目录（installer.nsi 的 OUTDIR，2026-11-11 补）
# 安装包成品归档在 B_交付归档\04_安装包\，工程树内不入库
dist_setup/
*.spec.bak
*.manifest
*.pkg
# 说明：OpenBB-CN.spec 是手工维护的打包配置源文件，必须入库；
#      此处仅排除 PyInstaller 自动生成的 .spec 备份/临时产物。

# ---------- 日志、临时与备份文件 ----------
logs/
*.log
*.tmp
*.bak
*.old
*_副本.*
*.dmp

# ---------- 密钥与凭据（严禁入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
data/yjb_token.json
data/ai_config.json
# 养基宝签名盐（DPAPI 密文，YJB2 魔数）：绝不入库、绝不进前端
data/yjb_secret.json

# ---------- 运行数据与缓存（运行时生成，不入库） ----------
data/portfolio.json
data/watchlist.json
# 第七轮波次 5 新增运行时数据：提醒规则/事件、筛选器全市场快照（每日 18:00 自动重建）
data/alerts.json
data/screener_snapshot.json
data/cache/
data/exports/
# 第十轮 R5/R7：板块成分映射预热缓存（2026-11-06 从 data/cache 迁至 DATA_DIR，清缓存不删但同样不入库）
data/board_cons.json
# 第十轮 R13：持仓逐日收益快照（每日收盘后落库的用户本地数据，随日期累积，不入库）
data/portfolio_snapshots/
# 第十轮 R11/C11：概念排行每日抽检日志（本地取证数据，随交易日累积，不入库）
data/concept_spotcheck.jsonl
# 第十轮 P4 R14：财报中文摘要落库（用户配置的 AI 生成，本地产物不入库）
data/summaries/
# v2.1.0 网页化：公网隧道组件 cloudflared（首次使用时按镜像自动下载，约 53MB，不入库）
data/bin/
# RT-01 脱敏审计痕迹：属用户本机安全记录（谁在何时做过解绑/清盐），不得随源码分发
data/audit/
data/*.db
data/*.sqlite
data/*.sqlite3
frontend/data/cache/

# ---------- 编辑器 / 系统文件 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
data/yjb_state.json
data/scan_tmp_*/
# 用户偏好与自建布局（本地单机数据，不入库）
data/user_prefs.json
data/dashboards.json
data/connectors.json

# PyInstaller 构建产物（阶段 9 封装）
build_v*/
dist_v*/

# 仓库内历史备份目录（归档整合后残留，仅本地保留，不入库）
C_历史备份/

# 临时工作区（第八轮）：不入库
data/_tmp/
tools/_ad_hoc/
# CDP 自测产生的 Edge 临时用户目录（v3.1.0 起，均由脚本 rmtree 清理，不入库）
# CDP 自测产生的 Edge 临时用户目录（脚本自清理，不入库）
tools/_*_profile/

# Windows 保留设备名残留（2026-11-13 RF-20261112-01 收尾登记，同日已清除）：
# Git Bash 下「cmd > NUL」会创建名为 NUL 的普通文件（pytest 残留输出）。
# 已于 2026-11-13 02:30 用「MoveFileW 同目录改名 NUL→NUL_del_tmp → os.remove」清除
# （直接 DeleteFileW 报 ERROR_ACCESS_DENIED；重命名法绕开保留名解析）。
# 此两行为防御性登记：未来若有脚本再生成 NUL，不影响 git 状态判定。
NUL
nul
