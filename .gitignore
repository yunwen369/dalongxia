# =============================================================
# OpenBB 中文投研工作台 · .gitignore
# 依据《工作规范》v7.0 §5.5；首次提交：阶段0 项目骨架初始化
# 原则：源码与配置模板入库；虚拟环境、构建产物、密钥、运行数据一律不入库
# =============================================================

# ---------- 虚拟环境（A 层运行资产，禁止入库） ----------
.venv/
.venv-verify/
venv/
env/

# ---------- Python 缓存与测试缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 构建产物（PyInstaller onedir） ----------
build/
dist/
*.spec.bak
*.manifest
*.pkg
# 说明：OpenBB-CN.spec 是手工维护的打包配置源文件，必须入库；
#      此处仅排除 PyInstaller 自动生成的 .spec 备份/临时产物。

# ---------- 日志、临时与备份文件 ----------
logs/
*.log
*.tmp
*.bak
*.old
*_副本.*
*.dmp

# ---------- 密钥与凭据（严禁入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
data/yjb_token.json
data/ai_config.json

# ---------- 运行数据与缓存（运行时生成，不入库） ----------
data/portfolio.json
data/cache/
data/exports/
data/*.db
data/*.sqlite
data/*.sqlite3
frontend/data/cache/

# ---------- 编辑器 / 系统文件 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
data/yjb_state.json
data/scan_tmp_*/
